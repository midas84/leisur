    function nuevo($nombre, $modo)
    {
        $ret = '';

        switch ($modo) {
            case 'ci':
                $usuario = $this->selectw('*', 'paciente', "estado=true and ci='" . $nombre .
                    "'");
                if (count($usuario) > 0) {
                    return $this->formulario($usuario[0]['id'], strftime("%Y-%m-%d", time()), '',
                        array(), '', 'preguardar'); //($usuario[0]['id']);
                } else {
                    $ret = '<h2>No existe paciente, vuela a intentar</h2>' . $this->formulario1();
                }
                break;
            case 'nombres':
                $sep = explode(",", $nombre);
                $usuario = $this->selectw('*', 'paciente', "estado=true and nombres='" . $sep[0] .
                    "' and apellidos='" . $sep[1] . "'");
                if (count($usuario) > 0) {
                    return $this->formulario($usuario[0]['id'], strftime("%Y-%m-%d", time()), '',
                        array(), '', 'preguardar'); //($usuario[0]['id']);
                } else {
                    $ret = '<h2>No existe paciente, vuela a intentar</h2>' . $this->formulario1();
                }
                break;
            case 'id':
                $usuario = $this->selectw('*', 'paciente', 'estado=true and id=' . $nombre);
                if (count($usuario) > 0) {
                    return $this->formulario($nombre, strftime("%Y-%m-%d", time()), '', array(), '',
                        'preguardar'); //($usuario[0]['id']);
                } else {
                    $ret = '<h2>No existe paciente, vuela a intentar</h2>' . $this->formulario1();
                }
                break;
            case 'atencion':
                $usuario = $this->buscarnombre($nombre, $modo);
                if (count($usuario) > 0) {
                    return $this->formulario($nombre, strftime("%Y-%m-%d", time()), '', array(), '',
                        'editar'); //($usuario[0]['id']);
                } else {
                    $ret = '<h2>No existe atencion, vuela a intentar</h2>' . $this->formulario1();
                }
                break;
        }
        return $ret;
    }
